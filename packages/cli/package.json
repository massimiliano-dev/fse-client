{
  "name": "@massimiliano-dev/fse-cli",
  "version": "0.0.0",
  "description": "`fse` command line: validate CDA2 documents locally and prepare FSE 2.0 gateway requests (dry run).",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/fse-client.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/massimiliano-dev/fse-client#readme",
  "bugs": "https://github.com/massimiliano-dev/fse-client/issues",
  "keywords": [
    "fse",
    "fascicolo-sanitario-elettronico",
    "fse-2.0",
    "cda2",
    "hl7",
    "sanita",
    "italy",
    "ehr",
    "cli"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "@massimiliano-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "bin": {
    "fse": "./dist/bin.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@massimiliano-dev/fse-core": "workspace:^",
    "@massimiliano-dev/fse-gateway-client": "workspace:^",
    "@massimiliano-dev/fse-validator": "workspace:^",
    "@massimiliano-dev/fse-pdf": "workspace:^",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@massimiliano-dev/fse-fixtures": "workspace:*"
  }
}
