{
  "name": "@massimiliano-dev/fse-validator",
  "version": "0.0.0",
  "description": "Local CDA2 validation for FSE 2.0: XSD (WebAssembly libxml2, no native build) and optional Schematron via SaxonJS.",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/fse-client.git",
    "directory": "packages/validator"
  },
  "homepage": "https://github.com/massimiliano-dev/fse-client#readme",
  "bugs": "https://github.com/massimiliano-dev/fse-client/issues",
  "keywords": [
    "fse",
    "fascicolo-sanitario-elettronico",
    "fse-2.0",
    "cda2",
    "hl7",
    "sanita",
    "italy",
    "ehr",
    "xsd",
    "schematron",
    "validation"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "@massimiliano-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@massimiliano-dev/fse-core": "workspace:^",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@massimiliano-dev/fse-fixtures": "workspace:*",
    "saxon-js": "2.7.0",
    "xslt3": "2.7.0"
  },
  "peerDependencies": {
    "saxon-js": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "saxon-js": {
      "optional": true
    }
  }
}
