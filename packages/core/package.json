{
  "name": "@massimiliano-dev/fse-core",
  "version": "0.0.0",
  "description": "Shared security primitives for the unofficial FSE 2.0 client: redaction of tokens/fiscal codes/CDA bodies and hardened XML input checks.",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/fse-client.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/massimiliano-dev/fse-client#readme",
  "bugs": "https://github.com/massimiliano-dev/fse-client/issues",
  "keywords": [
    "fse",
    "fascicolo-sanitario-elettronico",
    "fse-2.0",
    "cda2",
    "hl7",
    "sanita",
    "italy",
    "ehr",
    "redaction"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "@massimiliano-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {}
}
