# Copy to .env (gitignored) or, better, export from your secret manager. Paths only: never paste keys here.
FSE_SIGN_CERT_FILE=
FSE_SIGN_KEY_FILE=
FSE_SIGN_KEY_PASSPHRASE=
FSE_TLS_CERT_FILE=
FSE_TLS_KEY_FILE=
FSE_TLS_KEY_PASSPHRASE=
FSE_TLS_CA_FILE=
FSE_CONTEXT_FILE=
FSE_CATALOGS_DIR=vendor/it-fse-catalogs
# Set to "pre" only to run `pnpm test:gateway` against the PRE environment with synthetic data.
FSE_GATEWAY_ENV=
