{
  "name": "fse-client-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:gateway": "vitest run --project gateway",
    "check:secrets": "node scripts/check-secrets.mjs",
    "sync:catalogs": "node packages/validator/scripts/sync-catalogs.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "compile:schematron": "node packages/validator/scripts/compile-schematron.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "saxon-js"
      ]
    }
  }
}
